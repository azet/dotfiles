## gpg
alias keysearch=searchkey
alias searchkey='gpg --search-keys'
alias sign='gpg --clearsign'
alias keyshow=showkey
function showkey() {
  [[ -z "${1}" ]] && return 1
  gpg --export --armor "${1}"
  gpg -k --fingerprint "${1}"
}

## git
### git: shorthands for repositories
